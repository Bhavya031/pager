# Copy to .env and fill in. .env is gitignored.

# Agent ID from https://elevenlabs.io/app/conversational-ai
ELEVENLABS_AGENT_ID=

# API key from https://elevenlabs.io/app/settings/api-keys
# Required because the agent is private — server fetches a signed URL per page load.
# Also used for proactive TTS announcements played via afplay.
ELEVENLABS_API_KEY=

# Voice ID for proactive announcements (ID from https://elevenlabs.io/app/voice-lab).
# Optional — defaults to the locked Pager voice if unset.
ELEVENLABS_VOICE_ID=
